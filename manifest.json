{
  "manifest_version": 3,
  "name": "OpenCode Annotate (custom)",
  "short_name": "Annotate",
  "version": "1.6.1",
  "version_name": "1.6.1-custom.1",
  "description": "Point at what's broken and send it to your OpenCode or AshleyCode agent, with screenshot and selector.",
  "homepage_url": "https://github.com/eagleeyejack/opencode-chrome-annotation-extension",
  "minimum_chrome_version": "114",
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "Open the annotation panel"
    },
    "annotate-element": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Annotate an element on the current page"
    }
  },
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "notifications"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected/dom.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "OpenCode Annotate",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
